<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap for aeeusc.com — lists only the real public pages (matches
  robots.txt's allowed set). Account-only pages (/login, /portal,
  /dashboard, etc.) are deliberately left out, same reasoning as
  robots.txt's Disallow list: nothing there is meant to be indexed.

  lastmod values are approximate (the date this sitemap was written) —
  update them whenever a page's content meaningfully changes. This is a
  static file since the site is a client-rendered SPA with no build-time
  step that generates one automatically; if pages are added or removed,
  this file needs a matching manual update.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://aeeusc.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://aeeusc.com/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- The two public forms. Both are real pages a stranger is meant to
       land on, and neither was listed here. -->
  <url>
    <loc>https://aeeusc.com/interest</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://aeeusc.com/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

  <!-- One page per design team, added 2026-08-29 (see src/data/teams.js
       for the list these mirror). These are the pages most likely to be
       searched for by name: someone who heard about the Collegiate Wind
       Competition team, or about CHARGED, is searching for that phrase
       and not for "AEE at USC". Adding a team means adding a line here
       as well; nothing generates this file. -->
  <url>
    <loc>https://aeeusc.com/teams/marine-energy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://aeeusc.com/teams/wind</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://aeeusc.com/teams/hydropower</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://aeeusc.com/teams/charged</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://aeeusc.com/teams/shade-zones</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
